{
  "name": "garden-clock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A live clock wrapped in a procedurally grown garden that reacts to real weather and local time.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "eslint js tests scripts vite.config.js playwright.config.js",
    "lint:fix": "eslint js tests scripts vite.config.js playwright.config.js --fix",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "assets": "bash scripts/generate-assets.sh",
    "og": "node scripts/capture-og.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,css,html,md,json}": "prettier -w"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
